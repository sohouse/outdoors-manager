model Activity {
  id          String    @id @default(uuid())
  title       String?
  content     String?
  author      String?
  create_time DateTime? @default(now())
  leader_id   String?
  type        Int?      @default(0)
  desc        String?
  status      Int?      @default(0)
  start_time  DateTime? @default(now())
  end_time    DateTime? @default(now())

  @@map("activity")
}