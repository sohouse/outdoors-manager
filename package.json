{
  "name": "my-website",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "prisma": {
    "schema": "src/lib/database/schema/schema.prisma",
    "seed": "node --trace-warnings --loader ts-node/esm src/lib/database/seed/activity-seed.ts",
    "migrations": {
      "path": "src/lib/database/schema/migrations"
    }
  },
  "scripts": {
    "dev": "rimraf -rf .next src/lib/database/activity.json && next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "type": "tsc --noEmit --project tsconfig.json",
    "------------------ db command": "----",
    "generate: 生成客户端": "----",
    "dbg": "NODE_ENV=development prisma generate",
    "push: 同步数据库(不依赖迁移文件)": "----",
    "dbp": "NODE_ENV=development prisma db push",
    "migrate dev: 生成迁移文件 + 同步数据库 + 生成数据": "----",
    "dbmc": "NODE_ENV=development prisma migrate dev --create-only --skip-generate",
    "migrate dev: 生成迁移文件 + 同步数据库 + 生成客户端 + 跳过生成数据": "----",
    "dbm": "NODE_ENV=development prisma migrate dev --skip-seed",
    "dbmr": "NODE_ENV=development prisma migrate reset -f --skip-seed",
    "migrate dev: 生成迁移文件 + 同步数据库 + 生成客户端": "----",
    "dbms": "NODE_ENV=development prisma migrate dev",
    "dbmrs": "NODE_ENV=development prisma migrate reset -f",
    "dbs": "prisma db seed",
    "postinstall": "pnpm run dbg"
  },
  "dependencies": {
    "@ant-design/icons": "^6.1.0",
    "@hono/swagger-ui": "^0.6.0",
    "@hono/zod-openapi": "^1.2.2",
    "@hono/zod-validator": "^0.7.6",
    "@hookform/resolvers": "^5.2.2",
    "@prisma/adapter-pg": "^7.4.2",
    "@prisma/client": "^6.12.0",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@scalar/hono-api-reference": "^0.10.2",
    "@types/mdx": "^2.0.13",
    "antd": "^6.2.1",
    "better-auth": "^1.5.5",
    "better-sqlite3": "^12.6.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dayjs": "^1.11.19",
    "dotenv": "^17.2.4",
    "hono": "^4.12.5",
    "hono-openapi": "^1.3.0",
    "lodash": "^4.17.23",
    "lucide-react": "^0.562.0",
    "micromatch": "^4.0.8",
    "next": "16.1.6",
    "next-themes": "^0.4.6",
    "nodemailer": "^8.0.2",
    "pg": "^8.18.0",
    "prism-themes": "^1.9.0",
    "prisma-paginate": "^5.2.2",
    "react": "19.2.3",
    "react-day-picker": "^9.13.0",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.71.1",
    "rehype-prism-plus": "^2.0.2",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.3.5",
    "zod-openapi": "^5.4.6",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.2.0",
    "@tailwindcss/postcss": "^4",
    "@types/lodash": "^4.17.23",
    "@types/micromatch": "^4.0.10",
    "@types/node": "^20",
    "@types/pg": "^8.18.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.1.4",
    "prisma": "6.12.0",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  }
}
