{
  "name": "my-website",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "prisma": {
    "schema": "database/schema/schema.prisma",
    "seed": "node --trace-warnings --loader ts-node/esm database/seed/activitySeed.ts",
    "migrations": {
      "path": "database/schema/migrations"
    }
  },
  "scripts": {
    "dev": "rimraf -rf .next src/database/activity.json && next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "------------------ db command": "----",
    "dbg": "NODE_ENV=development prisma generate",
    "dbp": "NODE_ENV=development prisma db push",
    "dbmc": "NODE_ENV=development prisma migrate dev --create-only --skip-generate",
    "dbm": "NODE_ENV=development prisma migrate dev --skip-seed",
    "dbmr": "NODE_ENV=development prisma migrate reset -f --skip-seed",
    "dbms": "NODE_ENV=development prisma migrate dev",
    "dbmrs": "NODE_ENV=development prisma migrate reset -f",
    "dbs": "prisma db seed",
    "postinstall": "pnpm run dbm && pnpm run dbs && pnpm run dbg"
  },
  "dependencies": {
    "@ant-design/icons": "^6.1.0",
    "@hookform/resolvers": "^5.2.2",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.1.6",
    "@prisma/client": "^6.12.0",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@types/mdx": "^2.0.13",
    "antd": "^6.2.1",
    "better-sqlite3": "^12.6.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dayjs": "^1.11.19",
    "dotenv": "^17.2.4",
    "lodash": "^4.17.23",
    "lucide-react": "^0.562.0",
    "micromatch": "^4.0.8",
    "next": "16.1.6",
    "next-themes": "^0.4.6",
    "pg": "^8.18.0",
    "prism-themes": "^1.9.0",
    "prisma-paginate": "^5.2.2",
    "react": "19.2.3",
    "react-day-picker": "^9.13.0",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.71.1",
    "rehype-prism-plus": "^2.0.2",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.3.5",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.2.0",
    "@tailwindcss/postcss": "^4",
    "@types/lodash": "^4.17.23",
    "@types/micromatch": "^4.0.10",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.1.4",
    "prisma": "6.12.0",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  }
}
